# =================================================================
# EAGLE EYE - Environment Configuration Template
# =================================================================
# NOTE: The initial hackathon prototype runs completely offline and
# locally. No external cloud services or proprietary API keys are
# required for initialization.
#
# If local environment variables are needed in subsequent tasks,
# copy this file to '.env':
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux/macOS:        cp .env.example .env
# =================================================================

# Application Environment Mode (development / staging / production)
EAGLE_EYE_ENV=development

# Enable Debug Logging
EAGLE_EYE_DEBUG=True

# Optional Configuration Flags (Placeholders for future tasks)
# DEFAULT_CHECKLIST_PATH=sample_data/checklist_template.csv
# OUTPUT_DIRECTORY=outputs/
